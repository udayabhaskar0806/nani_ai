# ==============================================================================
# N.A.N.I. V2 — Environment Configuration Template
# Copy this file to .env and configure your desired model provider keys.
# ==============================================================================

# Core Application Settings
NANI_ENV=development
NANI_LOG_LEVEL=INFO
NANI_WORKSPACE_ROOT=/home/dell/Vibe Coding
NANI_DB_PATH=data/nani_v2.db

# Model Providers (Free Tier First)
# ------------------------------------------------------------------------------
# Google Gemini (Primary Multimodal Vision & Fast Reasoning - 1500 free req/day)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq Cloud (High-speed open models: Llama 3.3 70B, Llama 3.1 8B - free tier)
GROQ_API_KEY=

# DeepSeek (Direct reasoning API: DeepSeek-R1 / DeepSeek-V3)
DEEPSEEK_API_KEY=

# OpenRouter (Unified access: GPT-4o, Claude 3.5 Sonnet, Llama)
OPENROUTER_API_KEY=

# OpenAI (Optional direct API)
OPENAI_API_KEY=

# Local Ollama Fallback (http://localhost:11434 - 100% offline & free)
OLLAMA_BASE_URL=http://localhost:11434


# Security & Autonomy
# ------------------------------------------------------------------------------
# Default maximum steps per task before requiring check-in
NANI_MAX_STEPS_PER_TASK=15

# Require explicit confirmation for high-risk operations
NANI_STRICT_SAFETY_GATE=true
