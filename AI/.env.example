# ==========================================
# N.A.N.I. Core Configuration
# ==========================================

# Provider Mode:
# 'auto' (Recommended: uses Token Rotator with auto-failover across all free keys)
# or set to specific: 'ollama', 'groq', 'gemini', 'openrouter', 'deepseek'
AI_PROVIDER=auto

# ==========================================
# Multi-Provider Free Tier Keys (Optional)
# NANI automatically rotates between these when one hits rate limits!
# ==========================================

# 1. Groq (Free: https://console.groq.com - fast 70B models)
GROQ_API_KEY=

# 2. Google Gemini (Free: https://aistudio.google.com - 1,500 free requests/day)
GEMINI_API_KEY=

# 3. OpenRouter (Free: https://openrouter.ai - access to :free models)
OPENROUTER_API_KEY=

# 4. DeepSeek Direct (https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# 5. Local Ollama (100% Free & Offline fallback on CPU)
OLLAMA_BASE_URL=http://localhost:11434/v1

# GitHub Token (Optional: increases rate limit for repo radar)
GITHUB_TOKEN=

# Telegram Mobile/Desktop Bot Token (Optional: message @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=
